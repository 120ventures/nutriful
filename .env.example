VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# PostHog (EU Cloud) project API key. Without it: no analytics, no cookie banner.
VITE_POSTHOG_KEY=

# Cookiebot domain group id ("CBID", found under "Ihre Skripte").
# When set, Cookiebot runs the consent dialog instead of the built-in banner.
VITE_COOKIEBOT_ID=

# Edge Functions — comma-separated origins allowed by CORS (leave empty for * in local dev)
CORS_ALLOWED_ORIGINS=http://localhost:5173
